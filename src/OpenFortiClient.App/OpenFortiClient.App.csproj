<Project Sdk="Microsoft.NET.Sdk">

  <!-- Optional local signing (CodesignKey, CodesignProvision); see Signing.local.props.example. -->
  <Import Project="Signing.local.props" Condition="Exists('Signing.local.props')" />

  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>OpenFortiClient.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>OpenFortiClient</ApplicationTitle>
    <ApplicationId>io.github.openforticlient</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Mac Catalyst 17 = macOS 14 Sonoma, the lowest the .NET 10 Mac Catalyst SDK accepts -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>

    <!-- The Mac Catalyst SDK insists on an exact Xcode version (27.0); minor Xcode updates work fine. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>

    <!-- Compiled bindings everywhere; the XAML uses x:DataType. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
  </PropertyGroup>

  <!-- End-to-end test build (-p:E2E=true, see docs/development.md): its own bundle ID, so it runs next to
       the real app without touching its preferences, and unsigned, so it needs no profile. -->
  <PropertyGroup Condition="'$(E2E)' == 'true'">
    <ApplicationId>io.github.openforticlient.e2e</ApplicationId>
    <ApplicationTitle>OpenFortiClient E2E</ApplicationTitle>
    <CodesignKey></CodesignKey>
    <CodesignProvision></CodesignProvision>
    <!-- The test mode (Services/EndToEnd) exists only in this build, in Debug and Release alike. -->
    <DefineConstants>$(DefineConstants);E2E</DefineConstants>
    <!-- Its obj/bin live under artifacts/e2e (Directory.Build.props); keep the normal build's out of the source globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <!-- Signed release builds get the hardened runtime and secure timestamps, which notarisation requires
         (docs/release.md). Development builds stay without, so the debugger can attach. -->
    <UseHardenedRuntime Condition="'$(UseHardenedRuntime)' == '' And '$(Configuration)' == 'Release' And '$(CodesignKey)' != ''">true</UseHardenedRuntime>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(CodesignProvision)' != ''">Platforms/MacCatalyst/Entitlements.Signed.plist</CodesignEntitlements>
  </PropertyGroup>

  <!-- Native parts, in Swift, built for macOS (not Catalyst) with xcrun swiftc. See docs/architecture.md.
       * libOFCNative.dylib (src/OpenFortiClient.Native): the menu bar icon and the client of the privileged
         helper. Copied to Contents/MonoBundle, signed with the app, loaded at runtime with dlopen.
       * OpenFortiClientHelper (src/OpenFortiClient.Helper): the privileged helper, a launch daemon that
         SMAppService registers from Contents/Library/LaunchDaemons. Signed here with hardened runtime.
       * openfortivpn: built from pinned sources by scripts/build-openfortivpn.sh (once, into artifacts/openfortivpn),
         signed here and bundled in Contents/MacOS. The helper runs only this one.
       The helper and the native library learn the team ID (DevelopmentTeam, from Signing.local.props) to check
       each other's signature, and the helper to check openfortivpn's. -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <NativeOutput>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'native'))</NativeOutput>
    <NativeLibrary>$(NativeOutput)/libOFCNative.dylib</NativeLibrary>
    <HelperExecutable>$(NativeOutput)/OpenFortiClientHelper</HelperExecutable>
    <NativeBuildConfig>$(NativeOutput)/BuildConfig.swift</NativeBuildConfig>
    <SwiftTarget>arm64-apple-macos14.0</SwiftTarget>
    <!-- Changes when the signing identity does, so the native parts are signed again. -->
    <NativeSigningStamp>$(NativeOutput)/signing.stamp</NativeSigningStamp>
    <NativeTimestamp>--timestamp=none</NativeTimestamp>
    <NativeTimestamp Condition="'$(UseHardenedRuntime)' == 'true'">--timestamp</NativeTimestamp>
    <RepositoryRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))</RepositoryRoot>
    <OpenFortiVpnScript>$(RepositoryRoot)scripts/build-openfortivpn.sh</OpenFortiVpnScript>
    <!-- The version pinned in the build script, so it is set in one place. -->
    <OpenFortiVpnVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(OpenFortiVpnScript)')), 'OPENFORTIVPN_VERSION=(\S+)').Groups[1].Value)</OpenFortiVpnVersion>
    <OpenFortiVpnBuild>$(RepositoryRoot)artifacts/openfortivpn/$(OpenFortiVpnVersion)</OpenFortiVpnBuild>
    <BundledOpenFortiVpn>$(NativeOutput)/openfortivpn</BundledOpenFortiVpn>
  </PropertyGroup>

  <ItemGroup Condition="'$(NativeOutput)' != ''">
    <NativeSource Include="..\OpenFortiClient.Native\*.swift;..\OpenFortiClient.Helper\HelperProtocol.swift" />
    <HelperSource Include="..\OpenFortiClient.Helper\*.swift" />
    <None Include="$(NativeLibrary)" Link="libOFCNative.dylib" PublishFolderType="DynamicLibrary" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(HelperExecutable)" Link="Contents/MacOS/OpenFortiClientHelper" PublishFolderType="RootDirectory" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\OpenFortiClient.Helper\io.github.openforticlient.helper.plist" Link="Contents/Library/LaunchDaemons/io.github.openforticlient.helper.plist" PublishFolderType="RootDirectory" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(BundledOpenFortiVpn)" Link="Contents/MacOS/openfortivpn" PublishFolderType="RootDirectory" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(OpenFortiVpnBuild)/licenses/openfortivpn-LICENSE.txt;$(OpenFortiVpnBuild)/licenses/openfortivpn-LICENSE.OpenSSL.txt;$(OpenFortiVpnBuild)/licenses/OpenSSL-LICENSE.txt"
          Link="Contents/Resources/Licenses/%(Filename)%(Extension)" PublishFolderType="RootDirectory" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildNative" BeforeTargets="BeforeBuild" Condition="'$(NativeOutput)' != ''">
    <MakeDir Directories="$(NativeOutput)" />
    <!-- Rewritten only when the team changes, so the Swift builds below stay incremental. -->
    <WriteLinesToFile File="$(NativeBuildConfig)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by OpenFortiClient.App.csproj from DevelopmentTeam (Signing.local.props).;let helperTeamIdentifier = &quot;$(DevelopmentTeam)&quot;" />
    <WriteLinesToFile File="$(NativeSigningStamp)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="$(CodesignKey) $(NativeTimestamp)" />
    <Exec Command="&quot;$(OpenFortiVpnScript)&quot;" Condition="!Exists('$(OpenFortiVpnBuild)/openfortivpn')" />
    <CallTarget Targets="BuildNativeLibrary;BuildHelper;SignOpenFortiVpn" />
  </Target>

  <Target Name="BuildNativeLibrary" Inputs="@(NativeSource);$(NativeBuildConfig)" Outputs="$(NativeLibrary)">
    <Exec Command="xcrun swiftc -target $(SwiftTarget) -emit-library -module-name OFCNative -O -o &quot;$(NativeLibrary)&quot; @(NativeSource->'&quot;%(FullPath)&quot;', ' ') &quot;$(NativeBuildConfig)&quot;" />
  </Target>

  <Target Name="BuildHelper" Inputs="@(HelperSource);$(NativeBuildConfig);$(NativeSigningStamp)" Outputs="$(HelperExecutable)">
    <Exec Command="xcrun swiftc -target $(SwiftTarget) -O -module-name OpenFortiClientHelper -o &quot;$(HelperExecutable)&quot; @(HelperSource->'&quot;%(FullPath)&quot;', ' ') &quot;$(NativeBuildConfig)&quot;" />
    <!-- launchd runs it as root, so it gets the app's identity and the hardened runtime; ad hoc when unsigned. -->
    <Exec Command="codesign --force --options runtime $(NativeTimestamp) --identifier io.github.openforticlient.helper --sign &quot;$(CodesignKey)&quot; &quot;$(HelperExecutable)&quot;" Condition="'$(CodesignKey)' != ''" />
    <Exec Command="codesign --force --identifier io.github.openforticlient.helper --sign - &quot;$(HelperExecutable)&quot;" Condition="'$(CodesignKey)' == ''" />
  </Target>

  <!-- The helper checks this identifier and the team before it runs openfortivpn. -->
  <Target Name="SignOpenFortiVpn" Inputs="$(OpenFortiVpnBuild)/openfortivpn;$(NativeSigningStamp)" Outputs="$(BundledOpenFortiVpn)">
    <Copy SourceFiles="$(OpenFortiVpnBuild)/openfortivpn" DestinationFiles="$(BundledOpenFortiVpn)" />
    <Exec Command="codesign --force --options runtime $(NativeTimestamp) --identifier io.github.openforticlient.openfortivpn --sign &quot;$(CodesignKey)&quot; &quot;$(BundledOpenFortiVpn)&quot;" Condition="'$(CodesignKey)' != ''" />
    <Exec Command="codesign --force --identifier io.github.openforticlient.openfortivpn --sign - &quot;$(BundledOpenFortiVpn)&quot;" Condition="'$(CodesignKey)' == ''" />
  </Target>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0B0D11" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B0D11" BaseSize="128,128" />

    <!-- ResultLab logos and fonts (see THIRD-PARTY-NOTICES.md). -->
    <MauiImage Include="Resources\Images\*" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFortiClient.Core\OpenFortiClient.Core.csproj" />
  </ItemGroup>

</Project>
