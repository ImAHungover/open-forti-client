<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used instead of Entitlements.plist when a provisioning profile is set (CodesignProvision). -->
	<!-- No App Sandbox: the app must start /usr/bin/sudo and openfortivpn (see docs/architecture.md). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- MAUI SecureStorage keeps saved passwords in the Keychain under this group.
	     A restricted entitlement: launchd refuses to start the app if no provisioning profile grants it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)io.github.openforticlient</string>
	</array>
</dict>
</plist>
