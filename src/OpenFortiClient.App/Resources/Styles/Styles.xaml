<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ResultLab look: Inter for text, JetBrains Mono for the small uppercase section labels,
         6-point corners, cyan accent on dark. Fonts are registered in MauiProgram. -->

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Heading" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="24" />
    </Style>

    <!-- "[01] CONNECTION"-style labels, as on resultlab.io. -->
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="MonoMedium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Primary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- The connection status: plain text, read by the UI tests as written. -->
    <Style x:Key="StatusText" TargetType="Label">
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="Tagline" TargetType="Label">
        <Setter Property="FontFamily" Value="Mono" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="CharacterSpacing" Value="1.2" />
    </Style>

    <Style x:Key="Muted" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedForeground}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Input}" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="MinimumHeightRequest" Value="32" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="BackgroundColor" Value="{StaticResource Input}" />
        <Setter Property="FontFamily" Value="Inter" />
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource Primary}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Foreground}" />
        <Setter Property="BorderColor" Value="{StaticResource Border}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Stroke" Value="{StaticResource Border}" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource Foreground}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource Foreground}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource Surface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource Primary}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource MutedForeground}" />
    </Style>

</ResourceDictionary>
