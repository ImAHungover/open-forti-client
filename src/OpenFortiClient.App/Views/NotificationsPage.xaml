<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OpenFortiClient.App.ViewModels"
             xmlns:notifications="clr-namespace:OpenFortiClient.Core.Notifications;assembly=OpenFortiClient.Core"
             x:Class="OpenFortiClient.App.Views.NotificationsPage"
             xmlns:views="clr-namespace:OpenFortiClient.App.Views"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications">

    <ContentPage.Resources>
        <views:SeverityColorConverter x:Key="SeverityColor" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="24" RowSpacing="12">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Notifications" Style="{StaticResource Heading}" />
            <Button AutomationId="ClearNotificationsButton" Grid.Column="1" Text="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="100,180,100,*" Padding="12,0">
            <Label Text="Level" FontAttributes="Bold" />
            <Label Grid.Column="1" Text="Time" FontAttributes="Bold" />
            <Label Grid.Column="2" Text="Source" FontAttributes="Bold" />
            <Label Grid.Column="3" Text="Alert" FontAttributes="Bold" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <CollectionView ItemsSource="{Binding Entries}">
                <CollectionView.EmptyView>
                    <Label AutomationId="NoNotificationsLabel" Text="No notifications yet." Style="{StaticResource Muted}" Margin="12" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="notifications:NotificationEntry">
                        <Grid ColumnDefinitions="100,180,100,*" Padding="12,8">
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse WidthRequest="8" HeightRequest="8" VerticalOptions="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SeverityColor}}" />
                                <Label AutomationId="NotificationSeverity" Text="{Binding Severity}"
                                       TextColor="{Binding Severity, Converter={StaticResource SeverityColor}}" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding Time, StringFormat='{0:dd/MM/yyyy HH:mm:ss}'}" />
                            <Label Grid.Column="2" Text="{Binding Source}" />
                            <Label AutomationId="NotificationMessage" Grid.Column="3" Text="{Binding Message}" LineBreakMode="WordWrap" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
